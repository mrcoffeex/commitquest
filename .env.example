# Copy to .env in the repo root (apps read the same file via dotenv).

# Postgres — docker compose or a local cluster
DATABASE_URL=postgresql://commitquest:commitquest@localhost:5432/commitquest

# JWT for session cookies / Authorization headers
JWT_SECRET=dev-commitquest-jwt-change-me

# Shared secret between the Colyseus game server and the API
INTERNAL_SECRET=dev-commitquest-internal-change-me

# Set true to play without registering a GitHub OAuth app
AUTH_MOCK=true

# GitHub OAuth (required when AUTH_MOCK=false)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3001/api/auth/github/callback

# Webhook HMAC secret from the GitHub app / repo webhook settings
GITHUB_WEBHOOK_SECRET=dev-webhook-secret

# Optional token used by the webhook handler to fetch per-commit line diffs
GITHUB_TOKEN=

# Public URLs
WEB_ORIGIN=http://localhost:5173
API_URL=http://localhost:3001
COLYSEUS_URL=ws://localhost:2567

PORT=3001
COLYSEUS_PORT=2567
