# Copy to .env in the repo root (apps read the same file via dotenv).
# Do not commit .env — it can contain OAuth client secrets.

# Postgres — docker compose or a local cluster
DATABASE_URL=postgresql://commitquest:commitquest@localhost:5432/commitquest

# JWT for session cookies / Authorization headers (web + Colyseus)
JWT_SECRET=dev-commitquest-jwt-change-me

# Shared secret between the Colyseus game server and the API
INTERNAL_SECRET=dev-commitquest-internal-change-me

# GitHub OAuth is the primary player login. Keep this false unless you need
# the local "Dev login" / mock path (required for `npm run demo`).
AUTH_MOCK=false

# GitHub OAuth App — required when AUTH_MOCK=false
# Create at https://github.com/settings/developers → OAuth Apps → New OAuth App
#   Homepage URL:              http://localhost:5173
#   Authorization callback URL: http://localhost:3001/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3001/api/auth/github/callback

# Default scopes are read:user + user:email (identity). That is enough for
# public commit stats via webhooks / the public API.
# Private repos need a GitHub App (preferred) or classic OAuth `repo` scope:
# GITHUB_REQUEST_REPO_SCOPE=true
# Optional extra scopes (space or comma separated). Leave empty for defaults.
# GITHUB_OAUTH_SCOPES=

# Webhook HMAC secret from the GitHub App / repo webhook settings
GITHUB_WEBHOOK_SECRET=dev-webhook-secret

# Optional installation or PAT used by the webhook handler to fetch per-commit diffs
GITHUB_TOKEN=

# Public URLs
WEB_ORIGIN=http://localhost:5173
API_URL=http://localhost:3001
COLYSEUS_URL=ws://localhost:2567

PORT=3001
COLYSEUS_PORT=2567
