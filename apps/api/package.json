{
  "name": "@commitquest/api",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "generate": "prisma generate",
    "migrate": "sh -c 'set -a; [ -f ../../.env ] && . ../../.env; [ -f .env ] && . .env; set +a; prisma migrate deploy'",
    "migrate:dev": "sh -c 'set -a; [ -f ../../.env ] && . ../../.env; [ -f .env ] && . .env; set +a; prisma migrate dev'",
    "reset": "sh -c 'set -a; [ -f ../../.env ] && . ../../.env; [ -f .env ] && . .env; set +a; prisma migrate reset --force'",
    "seed": "sh -c 'set -a; [ -f ../../.env ] && . ../../.env; [ -f .env ] && . .env; set +a; tsx prisma/seed.ts'",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@commitquest/shared": "*",
    "@prisma/client": "^6.5.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.10",
    "prisma": "^6.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
